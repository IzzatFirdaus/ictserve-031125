{
	"$schema": "https://json.schemastore.org/package.json",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "node scripts/dev/check-node-version.js && npx vite",
		"check-node": "node scripts/dev/check-node-version.js",
		"wsl-redis-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\setup-wsl-redis.ps1",
		"test-dev-script": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\test-script.ps1",
		"dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1",
		"dev:win:minimal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName minimal",
		"dev:win:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName backend",
		"dev:win:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName frontend",
		"dev:win:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName ai",
		"dev:win:testing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName testing",
		"dev:win:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev.ps1 -ProfileName production",
		"dev:win:simple": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\start-dev-simple.ps1",
		"dev:helpers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev\\dev-helpers.ps1",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:helpdesk": "playwright test helpdesk.module.spec.ts",
		"test:e2e:loan": "playwright test loan.module.spec.ts",
		"test:e2e:devtools": "playwright test devtools.integration.spec.ts",
		"test:e2e:report": "playwright show-report",
		"playwright:install": "npx playwright install",
		"test:e2e:ci": "npx playwright install && npx playwright test",
		"test:accessibility": "playwright test accessibility.comprehensive.spec.ts",
		"test:accessibility:report": "playwright test accessibility.report.generator.ts",
		"test:accessibility:all": "npm run test:accessibility && npm run test:accessibility:report",
		"percy:exec": "percy exec --",
		"percy:build": "percy build",
		"percy:finalize": "percy finalize",
		"percy:upload": "percy upload",
		"percy:wrapper": "node scripts/percy/percy-cli-wrapper.cjs",
		"percy:build-manager": "node scripts/percy/build-manager.cjs",
		"percy:validate": "node scripts/percy/percy-cli-wrapper.cjs validate",
		"percy:status": "node scripts/percy/percy-cli-wrapper.cjs status",
		"percy:report": "node scripts/percy/percy-cli-wrapper.cjs report",
		"percy:simple": "node scripts/percy/simple-build-manager.cjs",
		"percy:degradation": "node scripts/percy/percy-degradation-manager.cjs",
		"percy:degradation-status": "node scripts/percy/percy-degradation-manager.cjs status",
		"percy:degradation-report": "node scripts/percy/percy-degradation-manager.cjs report",
		"percy:enable-degradation": "node scripts/percy/percy-cli-wrapper.cjs enable-degradation",
		"percy:disable-degradation": "node scripts/percy/percy-cli-wrapper.cjs disable-degradation",
		"percy:performance": "node scripts/percy/percy-performance-optimizer.cjs",
		"percy:performance-report": "node scripts/percy/percy-cli-wrapper.cjs performance-metrics",
		"percy:save-performance-report": "node scripts/percy/percy-cli-wrapper.cjs save-performance-report",
		"percy:wait-uploads": "node scripts/percy/percy-cli-wrapper.cjs wait-uploads",
		"percy:shutdown": "node scripts/percy/percy-cli-wrapper.cjs shutdown",
		"test:e2e:percy": "node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"test:e2e:percy:ui": "percy exec -- playwright test --ui",
		"test:e2e:percy:debug": "percy exec -- playwright test --debug",
		"test:e2e:percy:helpdesk": "node scripts/percy/build-manager.cjs run \"playwright test helpdesk.module.spec.ts\"",
		"test:e2e:percy:loan": "node scripts/percy/build-manager.cjs run \"playwright test loan.module.spec.ts\"",
		"test:e2e:percy:setup": "node scripts/percy/simple-build-manager.cjs run \"playwright test tests/e2e/percy-setup-validation.spec.ts\"",
		"test:e2e:percy:performance": "node scripts/percy/simple-build-manager.cjs run \"playwright test tests/e2e/percy-performance-validation.spec.ts\"",
		"test:e2e:percy:degradation": "node scripts/percy/percy-degradation-manager.cjs run-skip-percy \"playwright test tests/e2e/percy-degradation-validation.spec.ts\"",
		"test:e2e:no-percy": "node scripts/percy/percy-degradation-manager.cjs run-skip-percy \"playwright test\"",
		"test:e2e:local-percy": "node scripts/percy/percy-degradation-manager.cjs run-local-only \"playwright test\"",
		"test:e2e:fallback": "node scripts/percy/percy-degradation-manager.cjs run \"playwright test\"",
		"test:accessibility:percy": "node scripts/percy/build-manager.cjs run \"playwright test accessibility.comprehensive.spec.ts\"",
		"test:accessibility:no-percy": "node scripts/percy/percy-degradation-manager.cjs run-skip-percy \"playwright test accessibility.comprehensive.spec.ts\"",
		"ci:percy": "npx playwright install && node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"ci:percy:parallel": "npx playwright install && PERCY_PARALLEL_NONCE=$CI_BUILD_ID PERCY_PARALLEL_TOTAL=4 node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"ci:percy:branch": "npx playwright install && PERCY_BRANCH=$CI_BRANCH node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"ci:percy:pr": "npx playwright install && PERCY_PULL_REQUEST=$CI_PULL_REQUEST node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"ci:test:all": "npm run ci:percy && npm run test:accessibility:percy",
		"dev:percy:quick": "node scripts/percy/percy-degradation-manager.cjs run-local-only \"playwright test --grep='percy-setup-validation'\"",
		"dev:percy:dashboard": "node scripts/percy/simple-build-manager.cjs run \"playwright test dashboard.spec.ts\"",
		"dev:percy:forms": "node scripts/percy/simple-build-manager.cjs run \"playwright test helpdesk.spec.ts loan.spec.ts\"",
		"dev:percy:accessibility": "node scripts/percy/simple-build-manager.cjs run \"playwright test accessibility.comprehensive.spec.ts accessibility.interactions.spec.ts\"",
		"dev:percy:responsive": "node scripts/percy/simple-build-manager.cjs run \"playwright test --grep='responsive|mobile|tablet|desktop'\"",
		"dev:percy:hybrid": "node scripts/percy/simple-build-manager.cjs run \"playwright test --grep='guest|authenticated|hybrid'\"",
		"dev:percy:bahasa": "node scripts/percy/simple-build-manager.cjs run \"playwright test --grep='bahasa|melayu|language'\"",
		"production:percy": "PERCY_BRANCH=main node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"production:percy:baseline": "PERCY_TARGET_BRANCH=main node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"staging:percy": "PERCY_BRANCH=staging node scripts/percy/simple-build-manager.cjs run \"playwright test\"",
		"percy:health-check": "node scripts/percy/percy-cli-wrapper.cjs health-check",
		"percy:config-validate": "node scripts/percy/percy-cli-wrapper.cjs config-validate",
		"percy:token-validate": "node scripts/percy/percy-cli-wrapper.cjs token-validate",
		"percy:project-info": "node scripts/percy/percy-cli-wrapper.cjs project-info",
		"percy:build-info": "node scripts/percy/percy-cli-wrapper.cjs build-info",
		"percy:cleanup": "node scripts/percy/percy-cli-wrapper.cjs cleanup",
		"percy:package-validate": "node scripts/percy/validate-package-config.cjs",
		"percy:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\percy\\dev-scripts.ps1",
		"percy:dev:help": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\percy\\dev-scripts.ps1 -Command help"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@percy/cli": "^1.31.6",
		"@percy/playwright": "^1.0.10",
		"@playwright/test": "^1.57.0",
		"@tailwindcss/forms": "^0.5.2",
		"@tailwindcss/postcss": "^4.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^25.0.1",
		"@typescript-eslint/parser": "^8.46.3",
		"autoprefixer": "^10.4.2",
		"axe-core": "^4.11.0",
		"axios": "^1.11.0",
		"concurrently": "^9.0.1",
		"laravel-echo": "^2.2.6",
		"laravel-vite-plugin": "^2.0.0",
		"lightningcss": "^1.30.2",
		"playwright": "^1.57.0",
		"postcss": "^8.4.31",
		"pusher-js": "^8.4.0",
		"tailwindcss": "^4.0.0-alpha.25",
		"terser": "^5.44.0",
		"vite": "^7.3.0",
		"web-vitals": "^4.2.4"
	}
}
