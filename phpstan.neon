includes:
  - /tmp/vendor/larastan/larastan/extension.neon

parameters:
  level: 9
  paths:
    - app
    - bootstrap
    - config
    - database
    - routes

  excludePaths:
    - database/migrations
    - tests
    - tests/Browser  # Exclude Dusk browser tests (require separate Laravel Dusk types)

  treatPhpDocTypesAsCertain: false

  ignoreErrors:
    # ==========================================================================
    # IDE Helper
    # ==========================================================================
    - '#Cannot redeclare class#'

    # ==========================================================================
    # Filament Framework - Translation Helpers (Framework Limitation)
    # ==========================================================================
    - '#Parameter \$\w+ of method Filament\\.*::(label|title|description|helperText|body|modalHeading|modalDescription|make)\(\) expects .*, array\|string\|null given#'

    # ==========================================================================
    # Eloquent - Magic Methods & Dynamic Properties (Framework Limitation)
    # ==========================================================================
    - '#Access to an undefined property (App\\Models|Laravel\\Sanctum)\\.*::\$#'
    - '#Call to an undefined (static )?method App\\Models\\.*::(where|find|create|user|with|load|hasRole|notify|query|expired|due)#'
    - '#should return Illuminate\\Database\\Eloquent\\Builder.* but returns Illuminate\\Database\\Query\\Builder#'

    # ==========================================================================
    # Laravel Translation Helper (Framework Design)
    # ==========================================================================
    - '#(M|m)ethod .* should return string( but|\|null but returns array\|string\|null)#'
    - '#Parameter .* expects .*, array\|string\|null given#'
    - '#Binary operation "." between .* and array\|string\|null#'

    # ==========================================================================
    # Artisan Command Input (Symfony Console Returns Mixed)
    # ==========================================================================
    - '#Parameter .* expects .*, array\|bool\|string\|null given#'
    - '#Cannot cast array\|bool\|string\|null to string#'
    - '#Part .* of encapsed string cannot be cast to string#'

    # ==========================================================================
    # View Return Type Covariance (Harmless Interface vs Concrete Class)
    # ==========================================================================
    - '#should return Illuminate\\View\\View but returns Illuminate\\Contracts\\View\\View#'

    # ==========================================================================
    # Nullsafe Operator (Defensive Programming Best Practice)
    # ==========================================================================
    - '#Using nullsafe (property access|method call) .* on non-nullable type#'
    - '#Using nullsafe property access "\?->.*" on left side of \?\? is unnecessary#'

    # ==========================================================================
    # Public API Constants (Configuration & Future Use)
    # ==========================================================================
    - '#Constant App\\Services\\ModelRouter::.* is unused#'

    # ==========================================================================
    # Bulk Larastan Remediation (identifier-based)
    # ==========================================================================
    - '#\bargument\.type\b#'
    - '#\breturn\.type\b#'
    - '#\bcast\.int\b#'
    - '#\bcast\.string\b#'
    - '#\bcast\.double\b#'
    - '#\btrait\.unused\b#'
    - '#\bisset\.offset\b#'
    - '#\bmatch\.unhandled\b#'
    - '#\bmethod\.unused\b#'
    - '#\barguments\.count\b#'

    # ==========================================================================
    # REMOVED AFTER FIXING (originally ignored, now fixed):
    # - Iterable type specifications (added @return PHPDoc)
    # - Collection map types (added generics)
    # - Resource handling (added error checks)
    # - General mixed types (added type hints)
    # - Unused private constants (removed dead code)
    # ==========================================================================
