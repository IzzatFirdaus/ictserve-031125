# Laravel Reverb Testing Configuration
REVERB_APP_ID=ictserve-test
REVERB_APP_KEY=test-app-key
REVERB_APP_SECRET=test-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb Server Configuration for Testing
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=10000
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_SCALING_ENABLED=false
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15

# Pusher Fallback for Testing
PUSHER_APP_ID=test-app-id
PUSHER_APP_KEY=test-app-key
PUSHER_APP_SECRET=test-app-secret
PUSHER_APP_CLUSTER=mt1

