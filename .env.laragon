APP_NAME=ICTServe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ictserve.local
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_US

# Laragon Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# Optimized Redis Configuration for Laragon
# Using predis for better compatibility with Windows/Laragon
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_REVERB_DB=4
REDIS_PULSE_DB=5
REDIS_HORIZON_DB=6

# Redis Connection Optimization
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_PERSISTENT=false
REDIS_PREFIX=ictserve-laragon-

# Cache Configuration - Optimized for Redis
CACHE_STORE=redis
CACHE_PREFIX=ictserve_cache

# Session Configuration - Optimized for Redis
SESSION_DRIVER=redis

# Queue Configuration - Optimized for Redis with Horizon
QUEUE_CONNECTION=redis

# Mail Configuration (using log driver for development)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ictserve.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb WebSocket Configuration
REVERB_APP_ID=ictserve-app
REVERB_APP_KEY=local-app-key-for-development
REVERB_APP_SECRET=local-app-secret-for-development
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Telescope Configuration
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

# MCP Configuration
MEMORY_FILE_PATH=storage/mcp/memory.jsonl

# Development Tools
VITE_APP_NAME="${APP_NAME}"

# Supported locales for ICTServe (Bahasa Melayu-only active)
SUPPORTED_LOCALES=ms

# Minimum approver grade level (Grade 41+ is approver by default)
MIN_APPROVER_GRADE_LEVEL=41

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Session Configuration
SESSION_LIFETIME=7200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Laravel Horizon Configuration
HORIZON_NAME=ICTServe
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=
HORIZON_NOTIFICATION_EMAIL=admin@motac.gov.my

# Reverb Server Configuration
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=10000

# Reverb App Configuration
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000

# Reverb Scaling Configuration
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15

# Pusher (hosted) credentials - leave empty for local development
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${REVERB_HOST}"
VITE_PUSHER_PORT="${REVERB_PORT}"
VITE_PUSHER_SCHEME="${REVERB_SCHEME}"

# Cache Configuration
CACHE_PREFIX=ictserve_cache
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis

# AWS Configuration (leave empty for local development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AWS Bedrock Configuration (disabled for local development)
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_VERSION=latest
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_ENABLED=false

# Token used for agentic memory ingestion
MEMORY_API_TOKEN=

# GitHub personal access token (for development tools)
PAT_GITHUB_ACCESS_TOKEN=

# MCP Server API Keys (for development)
CONTEXT7_API_KEY=
DEEPL_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
FIGMA_ACCESS_TOKEN=

# Laravel Telescope Configuration
TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN=
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database

# Telescope Watchers
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# reCAPTCHA Enterprise Configuration (disabled for local development)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5

# Google Workspace SSO (disabled for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ClamAV Antivirus Scanner Configuration (disabled for local development)
CLAMAV_ENABLED=false
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.sock
CLAMAV_USE_TCP=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Ollama AI Configuration (for local AI development)
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CONNECTION_TIMEOUT=60
OLLAMA_CACHE_ENABLED=true
OLLAMA_CACHE_TTL=3600
OLLAMA_CACHE_DRIVER=redis
OLLAMA_DEFAULT_PROMPT="Anda adalah pembantu AI untuk sistem ICTServe MOTAC. Jawab dalam Bahasa Melayu sahaja."

# AI Broadcasting Configuration
AI_BROADCASTING_MONITORING_ENABLED=true
AI_BROADCASTING_LOG_EVENTS=false
AI_BROADCASTING_DEBUG=true
AI_BROADCASTING_SIMULATE_DELAYS=false

# AI Performance Monitoring
PULSE_AI_MONITORING_ENABLED=true
PULSE_AI_MONITORING_SAMPLE_RATE=1
PULSE_AI_SLOW_THRESHOLD=2000
