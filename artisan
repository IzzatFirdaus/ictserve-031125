#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Set vendor path for package discovery
putenv('COMPOSER_VENDOR_DIR=/tmp/vendor');

// Override system environment variables for local development
// Codespace sets APP_ENV=production by default, but we need local for Boost
putenv('APP_ENV=local');
putenv('APP_DEBUG=true');

// Register the Composer autoloader...
require '/tmp/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
