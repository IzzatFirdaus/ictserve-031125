services:
  app:
    build:
      args:
        INSTALL_DEV: "true"
    # Use .env.docker for compose-based dev to keep environment consistent for container runs
    env_file: ./.env.docker
    # Optionally useful for development: expose extra ports / mounts
    environment:
      APP_DEBUG: 'true'
    # For local dev flows we may also prefer to bind-mount node_modules and vendor differently
    # Example (left commented):
    # volumes:
    #   - ./:/var/www/html:cached
    #   - vendor:/var/www/html/vendor
