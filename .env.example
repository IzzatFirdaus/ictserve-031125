###
# Example .env for ICTServe
#
# This file is a safe template for local development. It contains non-secret placeholder
# values and instructions. Do NOT commit real secrets to version control. Use the
# environment-specific files (.env, .env.docker) for active configuration.
#
# Common workflows
#  - XAMPP / host-local MySQL: use the repository `.env` file (127.0.0.1 / root / no password)
#  - Docker Compose: copy `.env.docker` to `.env` before starting containers
#    (docker-compose up -d) — `.env.docker` already contains values that match docker-compose.yml
#
APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_US

# Local database (example placeholders)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# Docker example (if you plan to copy .env.docker -> .env)
# DB_HOST=db
# DB_USERNAME=laravel
# DB_PASSWORD=secret

# When switching between environments, consider using the provided script:
#   PowerShell (Windows):  .\scripts\switch-env.ps1 -env docker
#   Bash (macOS / WSL / Linux):  ./scripts/switch-env.sh docker

# Note: Use 127.0.0.1 instead of localhost for better reliability on Windows systems

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_US

# Supported locales for ICTServe (Bahasa Melayu-only active; English retained in lang files)
SUPPORTED_LOCALES=ms

# Comma-separated list of previous application keys for key rotation (optional)
APP_PREVIOUS_KEYS=

# Minimum approver grade level (Grade 41+ is approver by default)
MIN_APPROVER_GRADE_LEVEL=41

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0+ Primary Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# Redis 7.0+ Cache and Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=7200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Queue Configuration
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# Broadcast Queue Configuration (Requirements 3.4, 3.5, 7.3)
REDIS_BROADCAST_CONNECTION=default
REDIS_BROADCAST_QUEUE=broadcast
REDIS_BROADCAST_RETRY_AFTER=60
BROADCAST_REDIS_CONNECTION=default
BROADCAST_REDIS_QUEUE=broadcast

# Broadcast Queue Performance Settings (Requirement 7.3)
BROADCAST_TIMEOUT=30
BROADCAST_MAX_TRIES=3
BROADCAST_BACKOFF_FIRST=10
BROADCAST_BACKOFF_SECOND=30
BROADCAST_BACKOFF_THIRD=60

# Broadcast Queue Concurrency Settings (High Volume Handling)
BROADCAST_PROCESSES=3
BROADCAST_MAX_JOBS=1000
BROADCAST_MEMORY=128
BROADCAST_SLEEP=3
BROADCAST_REST=0

# Broadcast Queue Monitoring (Requirement 7.5)
BROADCAST_MONITORING_ENABLED=true
BROADCAST_SLOW_THRESHOLD=1000
BROADCAST_FAILED_THRESHOLD=5
BROADCAST_ALERT_EMAIL=

# Laravel Horizon Configuration
HORIZON_NAME=ICTServe
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=
HORIZON_NOTIFICATION_EMAIL=admin@motac.gov.my
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=#ictserve-alerts

# Laravel Reverb WebSocket Server Configuration (Requirements 3.1, 3.2, 3.3)
REVERB_APP_ID=ictserve-app
REVERB_APP_KEY=local-app-key-for-development
REVERB_APP_SECRET=local-app-secret-for-development
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb Server Configuration
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_MAX_REQUEST_SIZE=10000

# Reverb TLS Configuration (for production HTTPS)
REVERB_TLS_CERT_PATH=
REVERB_TLS_KEY_PATH=
REVERB_TLS_VERIFY_PEER=false
REVERB_TLS_VERIFY_PEER_NAME=false
REVERB_TLS_ALLOW_SELF_SIGNED=true

# Reverb App Configuration
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_CONNECTIONS=
REVERB_APP_MAX_MESSAGE_SIZE=10000

# Reverb Scaling Configuration (Redis pub/sub)
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15

# Frontend Reverb Configuration (Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Laravel Websockets (beyondcode) / Pusher compatibility (optional)
WEBSOCKETS_HOST=127.0.0.1
WEBSOCKETS_PORT=6001
WEBSOCKETS_SCHEME=http
WEBSOCKETS_PATH=/app

# Pusher (hosted) credentials
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${WEBSOCKETS_HOST}"
VITE_PUSHER_PORT="${WEBSOCKETS_PORT}"
VITE_PUSHER_SCHEME="${WEBSOCKETS_SCHEME}"

# Redis Cache Configuration
# For WSL local dev: use 127.0.0.1 so Windows apps can reach Redis
# For Docker Compose: set REDIS_HOST=redis (container name)
CACHE_STORE=redis
CACHE_PREFIX=ictserve_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# Option 1: Use phpredis for better performance if the PHP Redis extension is enabled.
# Set REDIS_CLIENT=phpredis and ensure the Redis extension is active in php.ini.
# For WSL: REDIS_HOST=127.0.0.1
# For Docker: REDIS_HOST=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_TIMEOUT=60
REDIS_READ_TIMEOUT=60
REDIS_RETRY_INTERVAL=100

# Redis Broadcasting Database (separate from cache)
REDIS_BROADCAST_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AWS Bedrock Configuration
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_VERSION=latest
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_ENABLED=false

# AWS Bedrock Nova Models Configuration
# Amazon Nova Models (Serverless)
AWS_BEDROCK_MODEL_NOVA_MICRO=amazon.nova-micro-v1:0
AWS_BEDROCK_MODEL_NOVA_LITE=amazon.nova-lite-v1:0
AWS_BEDROCK_MODEL_NOVA_PRO=amazon.nova-pro-v1:0

# Amazon Titan Models (Serverless)
AWS_BEDROCK_MODEL_TITAN_TEXT_LITE=amazon.titan-text-lite-v1
AWS_BEDROCK_MODEL_TITAN_TEXT_EXPRESS=amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_TITAN_EMBED_IMAGE=amazon.titan-embed-image-v1

# Claude 4.5 Models (Existing)
AWS_BEDROCK_MODEL_OPUS=global.anthropic.claude-opus-4-5-20251101-v1:0
AWS_BEDROCK_MODEL_SONNET=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Rate Limiting
AWS_BEDROCK_RATE_LIMIT_ENABLED=true
AWS_BEDROCK_RATE_LIMIT_PER_MINUTE=30

# Per-model rate limits (requests per minute)
AWS_BEDROCK_RATE_LIMIT_OPUS_RPM=10
AWS_BEDROCK_RATE_LIMIT_SONNET_RPM=20
AWS_BEDROCK_RATE_LIMIT_HAIKU_RPM=50
AWS_BEDROCK_RATE_LIMIT_NOVA_MICRO_RPM=100
AWS_BEDROCK_RATE_LIMIT_NOVA_LITE_RPM=80
AWS_BEDROCK_RATE_LIMIT_NOVA_PRO_RPM=40
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_LITE_RPM=60
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_EXPRESS_RPM=30

# Per-model token limits (tokens per minute)
AWS_BEDROCK_RATE_LIMIT_OPUS_TPM=20000
AWS_BEDROCK_RATE_LIMIT_SONNET_TPM=40000
AWS_BEDROCK_RATE_LIMIT_HAIKU_TPM=100000
AWS_BEDROCK_RATE_LIMIT_NOVA_MICRO_TPM=150000
AWS_BEDROCK_RATE_LIMIT_NOVA_LITE_TPM=120000
AWS_BEDROCK_RATE_LIMIT_NOVA_PRO_TPM=60000
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_LITE_TPM=80000
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_EXPRESS_TPM=50000

# Bedrock Configuration
AWS_BEDROCK_ROUTING_CACHE_TTL=3600
AWS_BEDROCK_SIMPLE_FAQ_MAX_WORDS=50
AWS_BEDROCK_MAX_PROMPT_CHARS=10000
AWS_BEDROCK_PREVENT_CLOUD_PII=true
AWS_BEDROCK_ENFORCE_MALAYSIA_RESIDENCY=false
AWS_BEDROCK_REQUIRE_CONSENT_FOR_INTERNAL=true
AWS_BEDROCK_BLOCK_RESTRICTED=true

# Bedrock Budget Controls
AWS_BEDROCK_BUDGET_ENABLED=false
AWS_BEDROCK_MONTHLY_BUDGET_USD=0
AWS_BEDROCK_BUDGET_HARD_STOP=false

VITE_APP_NAME="${APP_NAME}"

# Token used for agentic memory ingestion. Keep secret in production and only use for trusted agents.
MEMORY_API_TOKEN=

# GitHub personal access token used by some tools (Copilot / integration tests)
# - NOTE: GitHub repository secrets must not start with the prefix `GITHUB_`.
# - Recommended repository secret name for CI: PAT_GITHUB_ACCESS_TOKEN (do NOT use names beginning with `GITHUB_`).
# - Locally you can add this same name to your `.env` for convenience (example key below).
# - Minimum scopes: `repo` (if needed) + `workflow` (if workflows need to dispatch) or Copilot-specific scope
# IMPORTANT: Do NOT commit tokens to version control. If you find a token in the workspace, rotate it immediately.
PAT_GITHUB_ACCESS_TOKEN=

# Raptor mini (Preview) - enable preview feature across all clients
# Set to `false` to disable globally for non-preview environments
RAPTOR_MINI_PREVIEW=true

# MCP Server API Keys (obtain from respective services)
CONTEXT7_API_KEY=
DEEPL_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
FIGMA_ACCESS_TOKEN=

# MCP Memory File Path (for built-in memory server)
MEMORY_FILE_PATH=storage/mcp/memory.jsonl

# Laravel Telescope Configuration
TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN=
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
TELESCOPE_QUEUE_CONNECTION=
TELESCOPE_QUEUE=
TELESCOPE_QUEUE_DELAY=10

# Telescope Watchers
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_DUMP_WATCHER_ALWAYS=false
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# reCAPTCHA Enterprise Configuration (Requirements 14.2)
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/security/recaptcha
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5

# Google Workspace SSO (Optional - Requirements 38.1)
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ClamAV Antivirus Scanner Configuration (Requirements 14.3)
# Install ClamAV: sudo apt install clamav clamav-daemon
# Start daemon: sudo systemctl start clamav-daemon
CLAMAV_ENABLED=true
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.sock
CLAMAV_USE_TCP=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_MAX_FILE_SIZE=26214400
CLAMAV_QUARANTINE_PATH=storage/app/quarantine
CLAMAV_LOG_INFECTIONS=true

# Ollama AI Configuration (Requirements 6.1, 6.2, 7.1, 8.1, 8.4, 8.5)
# Local LLM server for AI features (FAQ Bot, Document Analysis, Auto-Reply)
# Install Ollama: https://ollama.ai/download
# Pull models: ollama pull gemma3:1b && ollama pull nomic-embed-text
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CONNECTION_TIMEOUT=60
OLLAMA_CACHE_ENABLED=true
OLLAMA_CACHE_TTL=3600
OLLAMA_CACHE_DRIVER=redis
OLLAMA_DEFAULT_PROMPT="Anda adalah pembantu AI untuk sistem ICTServe MOTAC. Jawab dalam Bahasa Melayu sahaja."
OLLAMA_API_KEY=

# AI Broadcasting Configuration (Requirements 11.1, 11.2, D16 v3.6.0)
# Real-time notifications for AI operations via Laravel Reverb
AI_BROADCASTING_MONITORING_ENABLED=true
AI_BROADCASTING_LOG_EVENTS=false
AI_BROADCASTING_DEBUG=false
AI_BROADCASTING_SIMULATE_DELAYS=false

# AI Performance Monitoring (Requirements 8.7, Laravel Pulse integration)
PULSE_AI_MONITORING_ENABLED=true
PULSE_AI_MONITORING_SAMPLE_RATE=1
PULSE_AI_SLOW_THRESHOLD=2000
