{{-- 
    FAQ Bot AI Component - Enhanced UI/UX (D00-D18 Compliant)
    ICTServe v3.6.0 - Bahasa Melayu sahaja (D15 v3.6.0)
    MyDS Design System v2025.2 - WCAG 2.2 AA Compliant
    Requirements: D12 (UI/UX Design), D13 (Frontend Framework), D14 (Style Guide), D18 (AI Chatbot)
--}}
<div class="grid grid-cols-4 gap-[18px] px-[18px] md:grid-cols-8 md:gap-6 md:px-6 lg:grid-cols-12 lg:gap-6 lg:px-6 lg:max-w-7xl lg:mx-auto h-full"
    x-data="{
        announcement: '',
        showSidebar: false,
        showModelComparison: false,
        conversationStats: {
            messages: {{ count($messages) }},
            tokens: 0,
            estimatedCost: 0
        },
        init() {
            Livewire.on('announce', ({ message }) => {
                this.announcement = message;
            });
            // Auto-save conversation state
            this.$watch('conversationStats', () => {
                localStorage.setItem('faq_bot_stats', JSON.stringify(this.conversationStats));
            });
        }
    }" lang="ms">

    {{-- Sidebar Panel (Conversation Management) --}}
    <div class="col-span-4 md:col-span-2 lg:col-span-4 flex flex-col h-full"
        :class="showSidebar ? 'block' : 'hidden md:block'">
        <div class="bg-white dark:bg-gray-900 rounded-l shadow-card border border-gray-200 dark:border-gray-700 h-full">
            {{-- Sidebar Header --}}
            <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white font-heading">
                        Pengurusan Perbualan
                    </h2>
                    <button type="button" @click="showSidebar = false"
                        class="md:hidden inline-flex items-center justify-center min-h-11 min-w-11 p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-m hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
                        aria-label="Tutup panel sisi">
                        <x-heroicon-o-x-mark class="w-5 h-5" aria-hidden="true" />
                    </button>
                </div>
            </div>

            {{-- Conversation Statistics --}}
            <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 dark:text-gray-400">Mesej Hari Ini</span>
                        <span class="font-medium text-gray-900 dark:text-white"
                            x-text="conversationStats.messages"></span>
                    </div>
                    @if ($aiProvider === 'bedrock')
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-600 dark:text-gray-400">Anggaran Kos</span>
                            <span class="font-medium text-gray-900 dark:text-white">
                                $<span x-text="conversationStats.estimatedCost.toFixed(4)"></span>
                            </span>
                        </div>
                    @endif
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 dark:text-gray-400">Penyedia AI</span>
                        <span
                            class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium rounded-full {{ $aiProvider === 'bedrock' ? 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300' : 'bg-primary-100 text-primary-800 dark:bg-primary-900/30 dark:text-primary-300' }}">
                            @if ($aiProvider === 'bedrock')
                                <x-heroicon-o-cpu-chip class="w-3 h-3" aria-hidden="true" />
                                Bedrock
