{
	"mcpServers": {
		"sequentialthinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
			"disabled": false,
			"autoApprove": ["sequentialthinking"]
		},
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory",
				"C:\\XAMPP\\htdocs\\ictserve-031125\\storage\\mcp\\memory.jsonl"
			],
			"disabled": false,
			"autoApprove": [
				"create_entities",
				"create_relations",
				"add_observations",
				"delete_entities",
				"delete_observations",
				"delete_relations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			]
		},
		"mimir": {
			"command": "node",
			"args": [
				"C:\\XAMPP\\htdocs\\ictserve-031125\\Mimir\\scripts\\mcp-http-client.cjs",
				"http://localhost:9042/mcp"
			],
			"env": {
				"MIMIR_API_URL": "http://localhost:9042"
			},
			"disabled": true,
			"autoApprove": []
		},
		"chrome-devtools": {
			"command": "npx",
			"args": ["-y", "chrome-devtools-mcp@latest"],
			"disabled": false,
			"autoApprove": [
				"navigate_page",
				"take_snapshot",
				"click",
				"fill",
				"evaluate_script"
			]
		},
		"firecrawl": {
			"command": "npx",
			"args": ["-y", "firecrawl-mcp"],
			"env": {
				"FIRECRAWL_API_KEY": "fc-3daa684db8a843029bc947742ea9347c"
			},
			"disabled": false,
			"autoApprove": []
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"],
			"disabled": false,
			"autoApprove": [
				"browser_navigate",
				"browser_click",
				"browser_snapshot",
				"browser_fill",
				"browser_evaluate"
			]
		},
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"env": {
				"CONTEXT7_API_KEY": "ctx7sk-c9ed2f9d-cb54-4436-9879-81ccbc95af03"
			},
			"disabled": false,
			"autoApprove": ["resolve-library-id", "get-library-docs"]
		},
		"laravel-boost": {
			"command": "php",
			"args": ["artisan", "boost:mcp"],
			"disabled": false,
			"autoApprove": [
				"application-info",
				"browser-logs",
				"database-connections",
				"database-query",
				"database-schema",
				"get-absolute-url",
				"get-config",
				"last-error",
				"list-artisan-commands",
				"list-available-config-keys",
				"list-available-env-vars",
				"list-routes",
				"read-log-entries",
				"report-feedback",
				"search-docs",
				"tinker"
			]
		},
		"fetch": {
			"command": "uvx",
			"args": ["mcp-server-fetch"],
			"disabled": false,
			"autoApprove": ["fetch"]
		},
		"deepl": {
			"command": "npx",
			"args": ["-y", "deepl-mcp-server"],
			"env": {
				"DEEPL_API_KEY": "58f6f571-d767-498a-a0cb-332d3fd5ed06:fx"
			},
			"disabled": false,
			"autoApprove": [
				"get_source_languages",
				"get_target_languages",
