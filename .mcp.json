				"rephrase_text"
			]
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "your_github_token_here"
			},
			"disabled": true,
			"autoApprove": []
		},
		"gitkraken": {
			"command": "gk",
			"args": ["mcp"],
			"disabled": true,
			"autoApprove": []
		}
