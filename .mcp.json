{
    "mcpServers": {
        "sequentialthinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "disabled": false,
            "autoApprove": [
                "sequentialthinking"
            ]
        },
        "memory": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory",
                "${workspaceFolder}/storage/mcp/memory.jsonl"
            ],
            "disabled": false,
            "autoApprove": [
                "create_entities",
                "create_relations",
                "add_observations",
                "delete_entities",
                "delete_observations",
                "delete_relations",
                "read_graph",
                "search_nodes",
                "open_nodes"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "disabled": false,
            "autoApprove": [
                "navigate_page",
                "take_snapshot",
                "click",
                "fill",
                "evaluate_script"
            ]
        },
        "firecrawl": {
            "command": "npx",
            "args": [
                "-y",
                "firecrawl-mcp"
            ],
            "env": {
                "FIRECRAWL_API_KEY": "$env:FIRECRAWL_API_KEY"
            },
            "disabled": true,
            "autoApprove": []
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ],
            "disabled": false,
            "autoApprove": [
                "browser_navigate",
                "browser_click",
                "browser_snapshot",
                "browser_fill",
                "browser_evaluate",
                "browser_close"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "env": {
                "CONTEXT7_API_KEY": "$env:CONTEXT7_API_KEY"
            },
            "disabled": true,
            "autoApprove": [
                "resolve-library-id",
                "get-library-docs"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "fetch": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-server-fetch"
            ],
            "disabled": false,
            "autoApprove": [
                "fetch"
            ]
        },
        "deepl": {
            "command": "npx",
            "args": [
                "-y",
                "deepl-mcp-server"
            ],
            "env": {
                "DEEPL_API_KEY": "$env:DEEPL_API_KEY"
            },
            "disabled": true,
            "autoApprove": [
                "get-source-languages",
                "get-target-languages",
                "translate-text",
                "rephrase-text"
            ]
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "$env:PAT_GITHUB_ACCESS_TOKEN"
            },
            "disabled": true,
            "autoApprove": []
        },
        "gitkraken": {
            "command": "gk",
            "args": [
                "mcp"
            ],
            "disabled": true,
            "autoApprove": []
        },
        "bedrock-opus": {
            "command": "node",
            "args": [
                "${workspaceFolder}/mcp-servers/bedrock-server.js"
            ],
            "env": {
                "AWS_ACCESS_KEY_ID": "$env:AWS_ACCESS_KEY_ID",
                "AWS_SECRET_ACCESS_KEY": "$env:AWS_SECRET_ACCESS_KEY",
                "AWS_BEDROCK_REGION": "us-east-1"
            },
            "disabled": true,
            "autoApprove": [
                "invoke_claude_opus",
                "invoke_claude_sonnet",
                "invoke_claude_haiku"
            ]
        },
        "herd": {
            "command": "php",
            "args": [
                "C:/Users/exatf/.config/herd/bin/herd-mcp.phar"
            ],
            "env": {
                "SITE_PATH": "C:\\XAMPP\\htdocs\\ictserve-031125"
            }
        }
    }
}