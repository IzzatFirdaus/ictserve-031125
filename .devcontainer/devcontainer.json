{
	"name": "ICTServe (Docker Compose)",
	"dockerComposeFile": ["../compose.yaml", "../compose.ours.yaml"],
	"service": "app",
	"workspaceFolder": "/var/www/html",
	"runServices": ["db", "app"],
	"shutdownAction": "stopCompose",
	"customizations": {
		"vscode": {
			"settings": {"terminal.integrated.defaultProfile.linux": "bash"},
			"extensions": ["ms-azuretools.vscode-docker", "bmewburn.vscode-intelephense-client", "esbenp.prettier-vscode"]
		}
	},
	"postCreateCommand": "sh -lc 'bash .devcontainer/setup-composer.sh'",
	"remoteUser": "www-data"
}
