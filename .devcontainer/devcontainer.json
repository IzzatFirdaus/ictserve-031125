{
	"name": "ICTServe (Docker Compose)",
	"dockerComposeFile": ["../compose.yaml", "../compose.dev.yaml", "../compose.ours.yaml"],
	"service": "app",
	"workspaceFolder": "/var/www/html",
	"runServices": ["db", "app"],
	"shutdownAction": "stopCompose",
	"customizations": {
		"vscode": {
			"settings": {"terminal.integrated.defaultProfile.linux": "bash"},
			"extensions": ["ms-azuretools.vscode-docker", "bmewburn.vscode-intelephense-client", "esbenp.prettier-vscode"]
		}
	},
	"postCreateCommand": "sh -lc 'bash scripts/codespaces-post-create.sh'",
	"remoteUser": "www-data",
	"remoteEnv": {
		"PAT_GITHUB_ACCESS_TOKEN": "${localEnv:PAT_GITHUB_ACCESS_TOKEN}",
		"GH_TOKEN": "${localEnv:GH_TOKEN}",
		"BROWSERSTACK_ACCESS_KEY": "${localEnv:BROWSERSTACK_ACCESS_KEY}",
		"BROWSERSTACK_USERNAME": "${localEnv:BROWSERSTACK_USERNAME}",
		"PERCY_TOKEN": "${localEnv:PERCY_TOKEN}",
		"COMPOSER_AUTH": "{\"github-oauth\": {\"github.com\": \"${localEnv:PAT_GITHUB_ACCESS_TOKEN}\"}}"
	},
	"containerEnv": {
		"COMPOSER_CACHE_DIR": "/home/www-data/.composer/cache",
		"NPM_CONFIG_CACHE": "/home/www-data/.npm/_cacache",
		"COMPOSER_ALLOW_SUPERUSER": "1"
	},
	"mounts": [
		"source=codespaces-composer-cache,target=/home/www-data/.composer/cache,type=volume",
		"source=codespaces-npm-cache,target=/home/www-data/.npm/_cacache,type=volume"
	]
}
