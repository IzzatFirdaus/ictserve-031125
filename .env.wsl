# WSL Environment Configuration for Laravel Horizon
# Copy this to your .env file or create .env.wsl

# Database (Windows MySQL via WSL)
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# Redis (WSL Redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue Configuration
QUEUE_CONNECTION=redis
HORIZON_PREFIX=horizon:

# Broadcasting
BROADCAST_DRIVER=redis

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis