###
# Local development environment template (.env.local)
#
# Copy this file to `.env.local` on your dev machine and update secrets where required.
# Do NOT commit `.env.local` — it's ignored by .gitignore because .env is ignored.
# Use the `scripts/switch-env.*` helpers to apply this configuration to `.env` during development.
###

APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

SUPPORTED_LOCALES=ms,en

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Comma-separated list of previous application keys for key rotation (optional)
APP_PREVIOUS_KEYS=

# Minimum approver grade level (Grade 41+ is approver by default)
MIN_APPROVER_GRADE_LEVEL=41

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use host-local MySQL (XAMPP) for local development
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# Use file session/cache/queue for fast local iteration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=ictserve_cache_local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailer - use 'log' to avoid sending emails in local testing
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional local-only developer tools
TELESCOPE_ENABLED=false

# Mimir local dev (only if you run Mimir locally)
NEO4J_PASSWORD=MxXhTKH3qntipYLa1e0QOluJ

# Optional: useful defaults for local dev
VITE_APP_NAME="${APP_NAME}"

# Other secrets/config can be copied from .env.example or set per-machine
