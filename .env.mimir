# .env.mimir - Mimir Memory System Configuration (DO NOT COMMIT SECRETS)
# Copy these variables into your main .env or keep separate and reference via docker-compose env_file
# SECURITY: Replace all __REPLACE__ placeholders before running services

# Neo4j Graph Database Connection
NEO4J_URI=bolt://neo4j_db:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# Mimir LLM Provider Configuration
MIMIR_DEFAULT_PROVIDER=ollama
MIMIR_LLM_API=http://copilot_api_server:4141
MIMIR_DEFAULT_MODEL=deepseek-r1:7b

# Embeddings Configuration
MIMIR_EMBEDDINGS_ENABLED=true
MIMIR_EMBEDDINGS_MODEL=all-minilm
MIMIR_EMBEDDINGS_API=http://copilot_api_server:4141

# Graph Indexing & Caching
MIMIR_AUTO_INDEX_DOCS=true
MIMIR_GRAPH_REFRESH_SECONDS=300
MIMIR_MAX_EMBED_BATCH=64
MIMIR_TRACE_SESSIONS=true

# Memory API Authentication
MEMORY_API_TOKEN=__REPLACE_WITH_SECURE_TOKEN__

# Optional Performance Tuning (uncomment to customize)
# MIMIR_EMBEDDINGS_DIM=384
# MIMIR_INDEX_MIN_TOKENS=12
# MIMIR_INDEX_MAX_TOKENS=4096
# MIMIR_REWRITE_PROMPT_ENABLED=false
# MIMIR_CONTEXT_EXPANSION_LIMIT=12

# NOTES:
# - Never commit this file with real secrets (add to .gitignore)
# - Rotate NEO4J_PASSWORD before production deployment
# - MEMORY_API_TOKEN should be a strong random string (use: openssl rand -hex 32)
# - Docker compose service mimir_server loads this via env_file directive
