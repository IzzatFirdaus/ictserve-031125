# .env.mimir - local secrets and config for Mimir (DO NOT COMMIT)
# Add your real secrets locally and never push this file to remote
# Example usage: Docker Compose will load these into the mimir-server container

# Neo4j connection
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__REPLACE_WITH_YOUR_NEO4J_PASSWORD__

# Mimir / LLM provider
MIMIR_DEFAULT_PROVIDER=copilot
MIMIR_LLM_API=http://copilot-api:4141
MIMIR_DEFAULT_MODEL=gpt-4.1

# Embeddings
MIMIR_EMBEDDINGS_ENABLED=true
MIMIR_EMBEDDINGS_MODEL=mxbai-embed-large
MIMIR_EMBEDDINGS_API=http://copilot-api:4141

# Auto-index docs on startup (true/false)
MIMIR_AUTO_INDEX_DOCS=true

# Memory API token for POST /api/v1/memory/import and agentic calls
MEMORY_API_TOKEN=__REPLACE_WITH_SECURE_TOKEN__

# Any other Mimir-specific environment variables can be added here.
# IMPORTANT: Keep this file out of Git. It's already recommended in .gitignore.
# Mimir / Neo4j memory graph configuration
# Copy or merge these into your main .env for local graph-enabled sessions.
# IMPORTANT: Replace placeholder passwords before production use.

MIMIR_DEFAULT_PROVIDER=ollama
MIMIR_LLM_API=http://copilot_api_server:4141
MIMIR_DEFAULT_MODEL=deepseek-r1:7b
MIMIR_EMBEDDINGS_ENABLED=true
MIMIR_EMBEDDINGS_MODEL=all-minilm
MIMIR_AUTO_INDEX_DOCS=true
MIMIR_GRAPH_REFRESH_SECONDS=300
MIMIR_MAX_EMBED_BATCH=64
MIMIR_TRACE_SESSIONS=true

# Neo4j connection
NEO4J_URI=bolt://neo4j_db:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Optional tuning (uncomment as needed)
# MIMIR_EMBEDDINGS_DIM=384
# MIMIR_INDEX_MIN_TOKENS=12
# MIMIR_INDEX_MAX_TOKENS=4096
# MIMIR_REWRITE_PROMPT_ENABLED=false
# MIMIR_CONTEXT_EXPANSION_LIMIT=12
