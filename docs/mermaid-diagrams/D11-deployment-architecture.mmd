graph TB
    CLIENT[END-USER CLIENTS<br/>Browser: Chrome, Firefox, Safari, Edge]
    LB[LOAD BALANCER<br/>HAProxy or AWS ALB<br/>SSL/TLS termination<br/>Health checks]
    
    APP1[APP-1<br/>Nginx<br/>PHP 8.2]
    APP2[APP-2<br/>Nginx<br/>PHP 8.2]
    APPN[APP-N<br/>Nginx<br/>PHP 8.2]
    
    REDIS[Redis Cluster<br/>Session + Cache + Queue]
    MYSQL[MySQL 8.0<br/>Primary + Replica]
    
    CLIENT -->|HTTPS/TLS 1.3| LB
    LB --> APP1
    LB --> APP2
    LB --> APPN
    
    APP1 --> REDIS
    APP2 --> REDIS
    APPN --> REDIS
    
    REDIS --> MYSQL
