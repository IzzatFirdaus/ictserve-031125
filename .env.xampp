###
# XAMPP Environment Configuration for ICTServe v3.6.1
#
# This configuration is optimized for XAMPP MySQL and WSL Redis setup
# Use this file by copying to .env or using the environment switching script
#
# XAMPP Configuration:
#   - MySQL: 127.0.0.1:3306 (root, no password)
#   - Apache: 127.0.0.1:80
#
# WSL Redis Configuration:
#   - Redis: 127.0.0.1:6379 (running in WSL)
#
# Usage:
#   Copy this file to .env: cp .env.xampp .env
#   Or use switching script: .\scripts\environment\switch-environment.ps1 -Environment xampp
#

APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_US

# Supported locales for ICTServe (Bahasa Melayu-only active)
SUPPORTED_LOCALES=ms

# Minimum approver grade level (Grade 41+ is approver by default)
MIN_APPROVER_GRADE_LEVEL=41

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MySQL 8.0+ Configuration (Requirements 3.1, 3.2)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# WSL Redis 7.0+ Configuration (Requirements 3.2, 3.3)
SESSION_DRIVER=redis
SESSION_LIFETIME=7200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# WSL Redis Cache and Session Configuration (Requirements 3.3, 6.1)
CACHE_STORE=redis
CACHE_PREFIX=ictserve_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Horizon Configuration for WSL Redis (Requirements 6.2)
HORIZON_NAME=ICTServe-XAMPP
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=
HORIZON_NOTIFICATION_EMAIL=admin@motac.gov.my
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=#ictserve-alerts

# Laravel Pulse Configuration for XAMPP MySQL (Requirements 6.1)
PULSE_ENABLED=true
PULSE_DOMAIN=
PULSE_PATH=pulse
PULSE_DB_CONNECTION=mysql
PULSE_INGEST_DRIVER=database
PULSE_INGEST_BUFFER=5000

# Pulse Recorder Settings
PULSE_USER_REQUESTS_ENABLED=true
PULSE_USER_REQUESTS_SAMPLE_RATE=1
PULSE_SLOW_QUERIES_ENABLED=true
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_EXCEPTIONS_ENABLED=true
PULSE_CACHE_INTERACTIONS_ENABLED=true

# Laravel Telescope Configuration for XAMPP MySQL (Requirements 6.3)
TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN=
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
TELESCOPE_DB_CONNECTION=mysql
TELESCOPE_QUEUE_CONNECTION=redis
TELESCOPE_QUEUE=
TELESCOPE_QUEUE_DELAY=10

# Telescope Watchers
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_DUMP_WATCHER_ALWAYS=false
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# Laravel Reverb WebSocket Server Configuration for WSL Redis (Requirements 6.4)
REVERB_APP_ID=ictserve-xampp-app
REVERB_APP_KEY=xampp-app-key-for-development
REVERB_APP_SECRET=xampp-app-secret-for-development
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb Server Configuration
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=10000

# Reverb App Configuration
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000

# Reverb Scaling Configuration with WSL Redis
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_REDIS_CONNECTION=default
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15

# Vite Configuration for Frontend
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (if needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AWS Bedrock Configuration
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_VERSION=latest
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_ENABLED=false

# AWS Bedrock Nova Models Configuration
AWS_BEDROCK_MODEL_NOVA_MICRO=amazon.nova-micro-v1:0
AWS_BEDROCK_MODEL_NOVA_LITE=amazon.nova-lite-v1:0
AWS_BEDROCK_MODEL_NOVA_PRO=amazon.nova-pro-v1:0

# Amazon Titan Models
AWS_BEDROCK_MODEL_TITAN_TEXT_LITE=amazon.titan-text-lite-v1
AWS_BEDROCK_MODEL_TITAN_TEXT_EXPRESS=amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_TITAN_EMBED_IMAGE=amazon.titan-embed-image-v1

# Claude 4.5 Models
AWS_BEDROCK_MODEL_OPUS=global.anthropic.claude-opus-4-5-20251101-v1:0
AWS_BEDROCK_MODEL_SONNET=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Rate Limiting
AWS_BEDROCK_RATE_LIMIT_ENABLED=true
AWS_BEDROCK_RATE_LIMIT_PER_MINUTE=30

# Per-model rate limits (requests per minute)
AWS_BEDROCK_RATE_LIMIT_OPUS_RPM=10
AWS_BEDROCK_RATE_LIMIT_SONNET_RPM=20
AWS_BEDROCK_RATE_LIMIT_HAIKU_RPM=50
AWS_BEDROCK_RATE_LIMIT_NOVA_MICRO_RPM=100
AWS_BEDROCK_RATE_LIMIT_NOVA_LITE_RPM=80
AWS_BEDROCK_RATE_LIMIT_NOVA_PRO_RPM=40
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_LITE_RPM=60
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_EXPRESS_RPM=30

# Per-model token limits (tokens per minute)
AWS_BEDROCK_RATE_LIMIT_OPUS_TPM=20000
AWS_BEDROCK_RATE_LIMIT_SONNET_TPM=40000
AWS_BEDROCK_RATE_LIMIT_HAIKU_TPM=100000
AWS_BEDROCK_RATE_LIMIT_NOVA_MICRO_TPM=150000
AWS_BEDROCK_RATE_LIMIT_NOVA_LITE_TPM=120000
AWS_BEDROCK_RATE_LIMIT_NOVA_PRO_TPM=60000
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_LITE_TPM=80000
AWS_BEDROCK_RATE_LIMIT_TITAN_TEXT_EXPRESS_TPM=50000

# Bedrock Configuration
AWS_BEDROCK_ROUTING_CACHE_TTL=3600
AWS_BEDROCK_SIMPLE_FAQ_MAX_WORDS=50
AWS_BEDROCK_MAX_PROMPT_CHARS=10000
AWS_BEDROCK_PREVENT_CLOUD_PII=true
AWS_BEDROCK_ENFORCE_MALAYSIA_RESIDENCY=false
AWS_BEDROCK_REQUIRE_CONSENT_FOR_INTERNAL=true
AWS_BEDROCK_BLOCK_RESTRICTED=true

# Bedrock Budget Controls
AWS_BEDROCK_BUDGET_ENABLED=false
AWS_BEDROCK_MONTHLY_BUDGET_USD=0
AWS_BEDROCK_BUDGET_HARD_STOP=false

VITE_APP_NAME="${APP_NAME}"

# Token used for agentic memory ingestion
MEMORY_API_TOKEN=

# GitHub personal access token
PAT_GITHUB_ACCESS_TOKEN=

# Raptor mini (Preview)
RAPTOR_MINI_PREVIEW=true

# MCP Server API Keys
CONTEXT7_API_KEY=
DEEPL_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
FIGMA_ACCESS_TOKEN=

# MCP Memory File Path
MEMORY_FILE_PATH=storage/mcp/memory.jsonl

# reCAPTCHA Enterprise Configuration
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5

# Google Workspace SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ClamAV Antivirus Scanner Configuration
CLAMAV_ENABLED=true
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.sock
CLAMAV_USE_TCP=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_MAX_FILE_SIZE=26214400
CLAMAV_QUARANTINE_PATH=storage/app/quarantine
CLAMAV_LOG_INFECTIONS=true

# Ollama AI Configuration for XAMPP Environment
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CONNECTION_TIMEOUT=60
OLLAMA_CACHE_ENABLED=true
OLLAMA_CACHE_TTL=3600
OLLAMA_CACHE_DRIVER=redis
OLLAMA_DEFAULT_PROMPT="Anda adalah pembantu AI untuk sistem ICTServe MOTAC. Jawab dalam Bahasa Melayu sahaja."
OLLAMA_API_KEY=

# AI Broadcasting Configuration with WSL Redis
AI_BROADCASTING_MONITORING_ENABLED=true
AI_BROADCASTING_LOG_EVENTS=false
AI_BROADCASTING_DEBUG=false
AI_BROADCASTING_SIMULATE_DELAYS=false

# AI Performance Monitoring with XAMPP MySQL
PULSE_AI_MONITORING_ENABLED=true
PULSE_AI_MONITORING_SAMPLE_RATE=1
PULSE_AI_SLOW_THRESHOLD=2000