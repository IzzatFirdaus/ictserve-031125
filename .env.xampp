# ICTServe v3.6.1 - XAMPP Environment Configuration
# Purpose: Environment variables for XAMPP MySQL + WSL Redis setup
# Usage: Copy to .env when switching to XAMPP environment

APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=base64:your-app-key-here
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# XAMPP MySQL Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

# WSL Redis Configuration
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Redis Connection Pools
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Broadcasting Configuration (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ictserve-app
REVERB_APP_KEY=your-reverb-key-here
REVERB_APP_SECRET=your-reverb-secret-here
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb Server Configuration
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vite Configuration for XAMPP
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail Configuration (for development)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ictserve.motac.gov.my"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Services Configuration
PULSE_ENABLED=true
PULSE_DB_CONNECTION=mysql
PULSE_REDIS_CONNECTION=default

TELESCOPE_ENABLED=true
TELESCOPE_DB_CONNECTION=mysql
TELESCOPE_PRUNE_HOURS=168

HORIZON_ENABLED=true
HORIZON_REDIS_CONNECTION=default

# Performance Monitoring
PULSE_USER_REQUESTS_ENABLED=true
PULSE_USER_REQUESTS_SAMPLE_RATE=1
PULSE_SLOW_QUERIES_ENABLED=true
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_EXCEPTIONS_ENABLED=true
PULSE_CACHE_INTERACTIONS_ENABLED=true

# Telescope Configuration
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_HTTP_CLIENT_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# Horizon Configuration
HORIZON_BALANCE=auto
HORIZON_MIN_PROCESSES=1
HORIZON_MAX_PROCESSES=10
HORIZON_TRIES=3
HORIZON_TIMEOUT=300

# ICTServe Specific Configuration
ICTSERVE_VERSION=3.6.1
ICTSERVE_ENVIRONMENT=xampp
ICTSERVE_LANGUAGE=ms
ICTSERVE_TIMEZONE=Asia/Kuala_Lumpur

# Audit System Configuration
AUDIT_ENABLED=true
AUDIT_DRIVER=database
AUDIT_CONSOLE=false

# File Storage Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Session Configuration
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_PREFIX=ictserve_cache
CACHE_TTL=3600

# Queue Configuration
QUEUE_FAILED_DRIVER=database-uuids

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development Tools
DEBUGBAR_ENABLED=true
CLOCKWORK_ENABLE=false

# Asset Configuration
ASSET_URL=null
MIX_PUSHER_APP_KEY="${REVERB_APP_KEY}"
MIX_PUSHER_APP_CLUSTER=mt1

# Security Configuration
BCRYPT_ROUNDS=12
HASH_VERIFY=true

# Localization
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

# XAMPP Specific Optimizations
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true
DB_ENGINE=null

# Redis Optimization for WSL
REDIS_TIMEOUT=5
REDIS_READ_TIMEOUT=10
REDIS_RETRY_INTERVAL=100
REDIS_PERSISTENT_CONNECTIONS=true

# Performance Tuning
OPCACHE_ENABLE=true
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=20000

# Development Environment Flags
XAMPP_MYSQL_ENABLED=true
WSL_REDIS_ENABLED=true
DOCKER_DISABLED=true
ENVIRONMENT_TYPE=xampp