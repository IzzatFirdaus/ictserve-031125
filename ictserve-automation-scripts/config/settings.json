{
	"automation": {
		"defaultTimeout": 30,
		"screenshotOnFailure": true,
		"videoRecording": false,
		"parallelExecution": false,
		"retryFailedTests": 3,
		"retryDelay": 2000
	},
	"browser": {
		"defaultBrowser": "Chrome",
		"windowSize": {
			"width": 1920,
			"height": 1080
		},
		"headless": false,
		"incognito": true,
		"disableExtensions": true,
		"disableImages": false,
		"userAgent": "ICTServe-Automation-Bot/1.0"
	},
	"demo": {
		"stepDelay": 1500,
		"highlightDuration": 2000,
		"annotationDuration": 3000,
		"pauseOnInteractive": true,
		"recordVideo": false,
		"captureScreenshots": true
	},
	"reporting": {
		"generateHtmlReport": true,
		"generateJsonReport": true,
		"generateCsvReport": false,
		"includeScreenshots": true,
		"includeTimings": true,
		"includeSystemInfo": true
	},
	"logging": {
		"level": "INFO",
		"logToFile": true,
		"logToConsole": true,
		"maxLogFiles": 10,
		"maxLogSizeMB": 50
	},
	"notifications": {
		"emailOnCompletion": false,
		"emailOnFailure": true,
		"slackWebhook": "",
		"teamsWebhook": ""
	}
}
