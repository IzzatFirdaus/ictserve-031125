{
	"mcpServers": {
		"sequentialthinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
			"env": [],
			"disabled": false,
			"autoApprove": ["sequentialthinking"]
		},
		"memory": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-memory"],
			"env": {
				"MEMORY_FILE_PATH": "C:\\XAMPP\\htdocs\\ictserve-031125\\storage\\mcp\\memory.jsonl"
			},
			"disabled": false,
			"autoApprove": [
				"create_entities",
				"create_relations",
				"add_observations",
				"delete_entities",
				"delete_observations",
				"delete_relations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			]
		},
		"chrome-devtools": {
			"command": "npx",
			"args": ["chrome-devtools-mcp@latest"],
			"env": [],
			"disabled": false,
			"autoApprove": [
				"navigate_page",
				"take_snapshot",
				"click",
				"fill",
				"evaluate_script"
			]
		},
		"firecrawl": {
			"command": "npx",
			"args": ["-y", "firecrawl-mcp"],
			"env": {
				"FIRECRAWL_API_KEY": "$input:FIRECRAWL_API_KEY"
			},
			"disabled": true,
			"autoApprove": []
		},
		"playwright": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"],
			"env": [],
			"disabled": false,
			"autoApprove": [
				"browser_navigate",
				"browser_click",
				"browser_snapshot",
				"browser_fill",
				"browser_evaluate"
			]
		},
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"env": {
				"CONTEXT7_API_KEY": "$input:CONTEXT7_API_KEY"
			},
			"disabled": true,
			"autoApprove": ["resolve-library-id", "get-library-docs"]
		},
		"laravel-boost": {
			"command": "php",
			"args": ["artisan", "boost:mcp"]
		},
		"fetch": {
			"command": "uvx",
			"args": ["mcp-server-fetch"],
			"env": [],
			"disabled": true,
			"autoApprove": ["fetch"]
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "$input:GITHUB_TOKEN"
			},
			"disabled": true,
			"autoApprove": []
		},
		"gitkraken": {
			"command": "gk",
			"args": ["mcp"],
			"env": [],
			"disabled": true,
			"autoApprove": []
		},
		"deepl": {
			"command": "npx",
			"args": ["-y", "deepl-mcp-server"],
			"env": {
				"DEEPL_API_KEY": "$input:DEEPL_API_KEY"
			},
			"disabled": true,
			"autoApprove": [
				"get-source-languages",
				"get-target-languages",
				"translate-text",
				"rephrase-text"
			]
		},
		"github/github-mcp-server": {
			"command": "npx",
			"args": ["-y", "github-mcp-server"],
			"disabled": true
		},
		"microsoft/playwright-mcp": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"],
			"disabled": true
		},
		"upstash/context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"disabled": true
		},
		"java-app-modernization-deploy": {
			"command": "npx",
			"args": ["-y", "java-app-modernization-mcp"],
			"disabled": true
		}
	}
}
