# NPM Configuration for ICTServe v3.6.1 with Percy Visual Testing Integration
# prefix=C:/laragon/www/ictserve-031125/scripts/dev/../../.npm-global
# cache=C:/laragon/www/ictserve-031125/scripts/dev/../../.npm-cache

# Performance optimizations for CI/CD
audit-level=moderate
fund=false
progress=false

# Registry configuration
registry=https://registry.npmjs.org/

# Timeout settings for CI environments
fetch-timeout=300000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Security settings
audit=true
audit-level=moderate

# Development settings
save-exact=true
package-lock=true

# Percy-specific environment variables (commented for reference)
# PERCY_TOKEN=your_percy_token_here
# PERCY_BRANCH=develop
# PERCY_TARGET_BRANCH=develop
# PERCY_PARALLEL_NONCE=build_identifier
# PERCY_PARALLEL_TOTAL=4
# PERCY_PROJECT=ictserve
