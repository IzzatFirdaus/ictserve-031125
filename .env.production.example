# ICTServe v3.6.0 - Ollama AI Integration Production Environment
# D11 v3.6.0 Technical Design Documentation Compliance

# Application Configuration
APP_NAME="ICTServe AI"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_FOR_PRODUCTION
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=https://ictserve.motac.gov.my
APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms

# Database Configuration (D09 v3.6.0)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve_production
DB_USERNAME=ictserve_user
DB_PASSWORD=SECURE_DATABASE_PASSWORD

# Redis Configuration (D11 v3.6.0)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=SECURE_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0

# Cache Configuration
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Broadcasting Configuration (D16 v3.6.0 Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ictserve-ai
REVERB_APP_KEY=GENERATE_REVERB_KEY
REVERB_APP_SECRET=GENERATE_REVERB_SECRET
REVERB_HOST=ictserve.motac.gov.my
REVERB_PORT=6001
REVERB_SCHEME=https

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.motac.gov.my
MAIL_PORT=587
MAIL_USERNAME=ictserve@motac.gov.my
MAIL_PASSWORD=SECURE_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ictserve@motac.gov.my
MAIL_FROM_NAME="ICTServe AI"

# Ollama AI Configuration (D11 v3.6.0)
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONNECTION_TIMEOUT=300
OLLAMA_CACHE_ENABLED=true
OLLAMA_CACHE_TTL=3600
OLLAMA_CACHE_DRIVER=redis
OLLAMA_QUANTIZED_MODEL=true
OLLAMA_DEFAULT_PROMPT="Bagaimana saya boleh membantu anda hari ini?"

# Performance Configuration (D11 v3.6.0)
OLLAMA_MAX_RESPONSE_TIME=5
OLLAMA_RATE_LIMIT_PER_USER=60
OLLAMA_RATE_LIMIT_PER_IP=1000

# Security Configuration (D11 v3.6.0)
OLLAMA_NETWORK_MONITORING=true
OLLAMA_BLOCK_EXTERNAL_CALLS=true
OLLAMA_PII_DETECTION=true
OLLAMA_AUDIT_RETENTION_DAYS=2555  # 7 years

# Laravel Pulse Configuration (D11 v3.6.0)
PULSE_ENABLED=true
PULSE_DOMAIN=ictserve.motac.gov.my
PULSE_PATH=admin/pulse
PULSE_STORAGE=database
PULSE_INGEST_DRIVER=redis

# Laravel Telescope Configuration (Superuser Only)
TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN=ictserve.motac.gov.my
TELESCOPE_PATH=admin/telescope

# Laravel Sanctum Configuration (D11 v3.6.0)
SANCTUM_STATEFUL_DOMAINS=ictserve.motac.gov.my,localhost,127.0.0.1

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# Monitoring & Alerting
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_SECRET=GENERATE_HEALTH_CHECK_SECRET
ALERT_EMAIL_ADMIN=admin@motac.gov.my
ALERT_EMAIL_SUPERUSER=superuser@motac.gov.my

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=90

# SSL/TLS Configuration
FORCE_HTTPS=true
HSTS_ENABLED=true
SECURE_COOKIES=true