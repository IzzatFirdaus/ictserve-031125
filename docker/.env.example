# Example environment file for docker-compose
# Copy this to docker/.env (or to project root) and keep secrets out of source control

# MySQL settings (used by docker-compose services)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=laravel
DB_PASSWORD=secret

# Optional: override image-specific behaviour
APP_ENV=local
APP_DEBUG=true
# Expose the application port used by the app container (server uses 8000)
APP_PORT=8000

# Controls used by the app container startup helper script (wait-for-db)
# WAIT_MAX_RETRIES - number of attempts to try connecting to DB before giving up
# WAIT_SLEEP_SEC - number of seconds to wait between attempts
WAIT_MAX_RETRIES=30
WAIT_SLEEP_SEC=2
