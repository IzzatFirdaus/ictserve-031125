###
# ICTServe Local Development .env
# Generated: 2025-12-02 â€” reorganized for clarity
###

#### Application
APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kuala_Lumpur

#### Localization
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SUPPORTED_LOCALES=ms,en

#### Maintenance / Logging
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#### Security & Hashing
BCRYPT_ROUNDS=12

#### Database (MySQL)
# Use 'db' if running in Docker compose; for local XAMPP/Laragon use 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=root
DB_PASSWORD=

#### Cache / Session / Queue
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=ictserve_cache
MEMCACHED_HOST=127.0.0.1

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

#### Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REDACTED
REDIS_PORT=6379

#### Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=REDACTED
MAIL_PASSWORD=REDACTED
MAIL_FROM_ADDRESS="noreply.bpm@motac.gov.my"
MAIL_FROM_NAME="${APP_NAME}"

#### Laravel Reverb & Vite (WebSockets)
REVERB_APP_ID=ictserve
REVERB_APP_KEY=REDACTED
REVERB_APP_SECRET=REDACTED
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}

VITE_APP_NAME="${APP_NAME}"

#### AWS / Bedrock / Nova
AWS_ACCESS_KEY_ID=REDACTED
AWS_SECRET_ACCESS_KEY=REDACTED
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BEDROCK_VERSION=latest
AWS_BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-5-20251101-v1:0

#### Third-party & Tools
CONTEXT7_API_KEY=REDACTED
DEEPL_API_KEY=REDACTED
FIRECRAWL_API_KEY=REDACTED
GITHUB_TOKEN=REDACTED
PAT_GITHUB_ACCESS_TOKEN=REDACTED

#### Neo4j / Mimir
NEO4J_PASSWORD=REDACTED
MEMORY_FILE_PATH=storage/mcp/memory.jsonl

#### Keep local overrides (these are placeholders for convenience)
# DB_HOST, DB_PORT, etc are already set above; modify those fields rather than duplicating inline


# Supported locales for ICTServe (Bahasa Melayu primary, English secondary)

# APP_MAINTENANCE_STORE=database
APP_MAINTENANCE_STORE=database

# Comma-separated list of previous application keys for key rotation (optional)
APP_PREVIOUS_KEYS=

# Minimum approver grade level (Grade 41+ is approver by default)
MIN_APPROVER_GRADE_LEVEL=41

# PHP_CLI_SERVER_WORKERS=4



# MySQL 8.0+ Primary Database Configuration
# DB_HOST: use 'db' when running both app + database in Docker compose (containers share network).
# For local dev (XAMPP / localhost) use 127.0.0.1 so the host resolves correctly on Windows.
## For local XAMPP MySQL default credentials use root with no password.
# If you're using Docker, use the credentials defined in docker-compose (or leave as-is)

# Redis 7.0+ Cache and Session Configuration

FILESYSTEM_DISK=local
# BROADCAST_CONNECTION=log
# QUEUE_CONNECTION=sync

