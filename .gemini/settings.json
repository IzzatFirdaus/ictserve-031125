{
    "permissions": {
        "deny": [
            "Write(./docs/**/*.md)",
            "Write(./.agents/**/*.md)",
            "Write(./.github/**/*.md)",
            "Write(./.kiro/**/*.md)"
        ]
    },
    "mcpServers": {
        "sequentialthinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "sequentialthinking"
            ]
        },
        "memory": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "create_entities",
                "create_relations",
                "add_observations",
                "delete_entities",
                "delete_observations",
                "delete_relations",
                "read_graph",
                "search_nodes",
                "open_nodes"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "chrome-devtools-mcp@latest"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "navigate_page",
                "take_snapshot",
                "click",
                "fill",
                "evaluate_script"
            ]
        },
        "firecrawl": {
            "command": "npx",
            "args": [
                "-y",
                "firecrawl-mcp"
            ],
            "env": {
                "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
            },
            "disabled": false,
            "autoApprove": []
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "browser_navigate",
                "browser_click",
                "browser_snapshot",
                "browser_fill",
                "browser_evaluate",
                "browser_close",
                "browser_wait_for"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "env": {
                "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
            },
            "disabled": false,
            "autoApprove": [
                "resolve-library-id",
                "get-library-docs"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "fetch": {
            "command": "uv",
            "args": [
                "run",
                "mcp-server-fetch"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "fetch"
            ]
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "github-mcp-server"
            ],
            "env": {
                "GITHUB_TOKEN": "${GITHUB_TOKEN}"
            },
            "disabled": false,
            "autoApprove": [
                "list_repositories",
                "get_repository",
                "get_file",
                "create_pull_request",
                "create_issue",
                "list_commits"
            ]
        },
        "gitkraken": {
            "command": "gk",
            "args": [],
            "env": [],
            "disabled": false,
            "autoApprove": []
        },
        "redis": {
            "command": "uv",
            "args": [
                "run",
                "--from",
                "redis-mcp-server@latest",
                "redis-mcp-server",
                "--url",
                "redis://localhost:6379/0"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": []
        },
        "deepl": {
            "command": "npx",
            "args": [
                "-y",
                "deepl-mcp-server"
            ],
            "env": {
                "DEEPL_API_KEY": "${DEEPL_API_KEY}"
            },
            "disabled": false,
            "autoApprove": [
                "get-source-languages",
                "get-target-languages",
                "translate-text",
                "rephrase-text"
            ]
        },
        "mimir": {
            "command": "docker",
            "args": [
                "exec",
                "-i",
                "mimir-server",
                "node",
                "build/index.js"
            ],
            "env": [],
            "disabled": false,
            "autoApprove": [
                "memory_node",
                "memory_edge",
                "memory_batch",
                "memory_lock",
                "memory_clear",
                "get_task_context",
                "index_folder",
                "remove_folder",
                "list_folders",
                "vector_search_nodes",
                "get_embedding_stats",
                "todo",
                "todo_list"
            ]
        }
    }
}