{
  "mcpServers": {
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false,
      "autoApprove": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory",
        "storage/mcp/memory.jsonl"
      ],
      "disabled": false,
      "autoApprove": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    },
    "mimir": {
      "command": "node",
      "args": [
        "Mimir/scripts/mcp-http-client.js",
        "http://localhost:9042/mcp"
      ],
      "env": {
        "MIMIR_API_URL": "http://localhost:9042"
      },
      "disabled": true,
      "autoApprove": [
        "memory_node",
        "memory_edge",
        "memory_batch",
        "vector_search_nodes",
        "todo",
        "todo_list",
        "index_folder",
        "list_folders",
        "get_task_context",
        "get_embedding_stats"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "navigate_page",
        "take_snapshot",
        "click",
        "fill",
        "evaluate_script",
        "list_pages",
        "performance_start_trace",
        "list_console_messages"
      ]
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "$input:FIRECRAWL_API_KEY"
      },
      "disabled": false,
      "autoApprove": []
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_click",
        "browser_snapshot",
        "browser_fill",
        "browser_evaluate"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "$input:CONTEXT7_API_KEY"
      },
      "disabled": false,
      "autoApprove": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ],
      "env": {
        "APP_ENV": "local",
        "MCP_CONNECTION_MODE": "persistent"
      },
      "disabled": false,
      "autoApprove": [
        "application-info",
        "browser-logs",
        "database-connections",
        "database-query",
        "database-schema",
        "get-absolute-url",
        "get-config",
        "last-error",
        "list-artisan-commands",
        "list-available-config-keys",
        "list-available-env-vars",
        "list-routes",
        "read-log-entries",
        "report-feedback",
        "search-docs",
        "tinker"
      ]
    },
    "deepl": {
      "command": "npx",
      "args": [
        "-y",
        "deepl-mcp-server"
      ],
      "env": {
        "DEEPL_API_KEY": "$input:DEEPL_API_KEY"
      },
      "disabled": false,
      "autoApprove": [
        "get-source-languages",
        "get-target-languages",
        "translate-text",
        "rephrase-text",
        "get-writing-styles-and-tones",
        "translate-document"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$input:GITHUB_TOKEN"
      },
      "disabled": false,
      "autoApprove": [
        "create_repository",
        "get_repository",
        "list_repositories",
        "search_repositories",
        "create_issue",
        "get_issue",
        "list_issues",
        "update_issue",
        "create_pull_request",
        "get_pull_request",
        "list_pull_requests",
        "update_pull_request",
        "get_file_contents",
        "create_or_update_file",
        "push_files",
        "create_branch",
        "list_branches",
        "get_commit",
        "list_commits",
        "fork_repository"
      ]
    },
    "gitkraken": {
      "command": "gk",
      "args": [
        "mcp"
      ],
      "disabled": false,
      "autoApprove": [
        "gitkraken_workspace_list",
        "git_add_or_commit",
        "git_blame",
        "git_branch",
        "git_checkout",
        "git_log_or_diff",
        "git_push",
        "git_stash",
        "git_status",
        "git_worktree"
      ]
    }
  }
}