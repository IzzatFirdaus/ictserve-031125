###
# Docker Compose Environment Configuration for ICTServe
#
# This file is used by docker-compose.yml and provides container-specific
# configuration. It is safe to commit with placeholder values.
#
# For production deployments, override sensitive values via:
#   - Docker secrets
#   - Environment-specific .env files
#   - CI/CD pipeline variables
#

# Application Settings
APP_NAME="ICTServe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# Localization (v3.6.1: Bahasa Melayu primary)
APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_US
SUPPORTED_LOCALES=ms

# Database Configuration (Docker Compose Service Names)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=laravel
DB_PASSWORD=secret

# Redis Configuration (Docker Compose Service Name)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=ictserve_cache

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis

# Broadcasting Configuration
BROADCAST_CONNECTION=reverb

# Laravel Reverb Configuration
REVERB_APP_ID=ictserve
REVERB_APP_KEY=reverb-key
REVERB_APP_SECRET=reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite Configuration (for development)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${REVERB_APP_KEY}"
VITE_PUSHER_HOST="${REVERB_HOST}"
VITE_PUSHER_PORT="${REVERB_PORT}"
VITE_PUSHER_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_CLUSTER=mt1

# Mail Configuration (Development)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ictserve.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (Placeholders for Bedrock integration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bedrock Configuration
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# Ollama Configuration (Local LLM)
OLLAMA_ENABLED=true
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama2

# Percy Visual Testing (Placeholders)
PERCY_TOKEN=
PERCY_BRANCH=

# BrowserStack Configuration (Placeholders)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_PROJECT_NAME=ICTServe
BROWSERSTACK_BUILD_NAME=

# Docker-Specific Settings
# Controls for wait-for-db.sh startup script
WAIT_MAX_RETRIES=30
WAIT_SLEEP_SEC=2

# npm Configuration (for www-data user)
NPM_CONFIG_CACHE=/var/www/.npm-cache
NPM_CONFIG_PREFIX=/var/www/.npm-global
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Telescope Configuration (Development)
TELESCOPE_ENABLED=true

# Horizon Configuration
HORIZON_BASIC_AUTH=false

# Security & PDPA
PDPA_CONSENT_REQUIRED=true
DATA_CLASSIFICATION_STRICT=true

# Feature Flags
FEATURE_AI_ROUTING=true
FEATURE_RAG_PIPELINE=true
FEATURE_APPROVAL_WORKFLOW=true
