## The original DB-based cache/session/queue. Overridden below to use Redis in Docker.
#CACHE_STORE=database
#SESSION_DRIVER=database
#QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Use Redis for cache/session/queues inside docker development
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

