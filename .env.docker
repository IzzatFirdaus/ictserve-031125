###
# Docker environment file for ICTServe
# Use this file when running the application and database inside Docker Compose.
#
# How to use:
#  - When you want to run app + database in Docker (docker-compose), copy/rename this file to .env
#    (or load it into your container environment) and bring up the containers:
#      cp .env.docker .env
#      docker-compose up -d
#  - When you want to run on XAMPP / local host, use the normal .env which is tuned for localhost.
###

APP_NAME="ICTServe"
APP_ENV=docker
APP_KEY=base64:tTp2q87RkpaD+JrF8YzrntjQGmQHXlKMoAuUrFDYJh0=""
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

SUPPORTED_LOCALES=ms,en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker MySQL service (docker-compose service name: 'db')
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ictserve
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file
CACHE_PREFIX=ictserve_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply.bpm@motac.gov.my"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=ictserve
REVERB_APP_KEY=7b8b5ab0c237a76fffe1be459000dbcf
REVERB_APP_SECRET=f02a3e255467985d3af357e5c4df5b2b0087bb01d0d0d34510908ba6b70fe310
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite / frontend
VITE_REVERB_APP_KEY=7b8b5ab0c237a76fffe1be459000dbcf
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
