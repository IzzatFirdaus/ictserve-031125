# Git
.git
.gitignore
.gitmodules

# Docker files (except configs we need)
docker-compose*.yml
compose.dev.yaml
.dockerignore

# Documentation (keep essential docs)
*.md
docs/
README.md
!docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (will be installed in container)
node_modules/
npm-debug.log
yarn-error.log
.npm/

# Laravel (keep structure, exclude runtime files)
/vendor/
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
.env.local*
.env.backup
.env.production

# Testing
phpunit.xml
.phpunit.result.cache

# Build artifacts (will be built in container)
/public/hot
/public/storage

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

