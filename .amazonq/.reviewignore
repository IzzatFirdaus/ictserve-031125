# Amazon Q Code Review Ignore Patterns

# Dependencies
vendor/
node_modules/

# Build artifacts
public/build/
public/hot
public/storage

# Cache
bootstrap/cache/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/

# Environment
.env
.env.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Compiled assets
*.min.js
*.min.css
mix-manifest.json

# Test coverage
coverage/
.phpunit.result.cache

# Documentation (optional - remove if you want to scan docs)
# docs/

# Temporary files
*.tmp
*.bak
*.log
